% Chapter and section numbers are the document's own and are kept verbatim,
% so that existing cross-references in the text stay correct.
\newcommand{\repchapter}[2]{%
  \needspace{9\baselineskip}\par\vspace{1.5\baselineskip}\phantomsection
  \ifx\relax#1\relax\addcontentsline{toc}{chapter}{#2}\markboth{#2}{#2}%
  \else\addcontentsline{toc}{chapter}{\protect\numberline{#1}#2}\markboth{#2}{#2}\fi
  {\noindent\raggedright\color{socialink}\LARGE\bfseries\ifx\relax#1\relax\else#1.\hspace{0.45em}\fi#2\par}%
  \vspace{4pt}{\noindent\color{socialrule}\rule{\linewidth}{0.7pt}\par}\vspace{0.7\baselineskip}\@afterindentfalse\@afterheading}
\newcommand{\repchapternew}[2]{\clearpage\vspace*{-1.5\baselineskip}\repchapter{#1}{#2}}
\newcommand{\repsection}[2]{%
  \needspace{5\baselineskip}\par\vspace{0.9\baselineskip}\phantomsection
  \ifx\relax#1\relax\addcontentsline{toc}{section}{#2}\else\addcontentsline{toc}{section}{\protect\numberline{#1}#2}\fi
  {\noindent\raggedright\color{socialink}\large\bfseries\ifx\relax#1\relax\else#1\hspace{0.5em}\fi#2\par}%
  \vspace{0.35\baselineskip}\@afterindentfalse\@afterheading}
\newcommand{\repsubsection}[1]{%
  \needspace{4\baselineskip}\par\vspace{0.6\baselineskip}%
  {\noindent\raggedright\color{socialink}\normalsize\bfseries\itshape#1\par}\vspace{0.2\baselineskip}\@afterindentfalse\@afterheading}
\renewcommand*\l@chapter[2]{\addpenalty{-300}\vskip 0.55em\begingroup\setlength\@tempdima{2.1em}\parindent\z@\rightskip\@pnumwidth\parfillskip-\@pnumwidth\leavevmode\bfseries\advance\leftskip 2.1em\hskip-\leftskip#1\nobreak\hfil\nobreak\hb@xt@\@pnumwidth{\hss#2}\par\penalty\@highpenalty\endgroup}
\renewcommand*\l@section{\@dottedtocline{1}{2.1em}{2.8em}}
\newcommand{\reptoc}{%
  \clearpage{\noindent\color{socialink}\LARGE\bfseries\contentsname\par}\vspace{4pt}{\noindent\color{socialrule}\rule{\linewidth}{0.7pt}\par}\vspace{0.6\baselineskip}%
  \begingroup\renewcommand{\addvspace}[1]{}\@starttoc{toc}\endgroup\clearpage}
